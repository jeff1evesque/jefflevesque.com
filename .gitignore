##
## ignore files
##
/**/.DS_Store
/**/package-lock.json
/**/*.svg
/**/*.afdesign~lock~
/jsx/aws-exports.js
/jsx/is_local.js*
##
## deploy: copied from 'deploy.replace' and filled in with the cognito ids of
## the distribution being deployed to, so the working copy stays untracked
##
/deploy
/jsx/aws-exports.js*
##
## the '.replace' files are templates, and templates are INPUT rather than
## generated output: a build copies each one and substitutes its REPLACE-*
## tokens to produce the ignored file beside it. The globs above are broad
## enough to catch 'aws-exports.js-e' and friends, so the templates have to be
## exempted by name or a clean clone has nothing to build from
##
!/jsx/aws-exports.js.replace
!/jsx/is_local.js.replace
/jsx/content.js
/output.md
/extract_*.py

##
## build output: 'deploy' compiles style.css then moves it into static/, so a
## tracked copy only ever shows up as deleted after a build
##
/scss/style.css

##
## jest coverage output ('npm test')
##
/jsx/clover.xml
/jsx/coverage-final.json
/jsx/coverage-summary.json
/jsx/lcov.info

##
## ignore directories
##
jsx/node_modules/
scss/node_modules/
static/
certs/
jsx/dist/
jsx/lcov-report/
**/__pycache__

##
## linter caches: regenerated on every run and machine-local, so they only ever
## show up as churn in a diff
##
/.ruff_cache/
/jsx/.eslintcache
