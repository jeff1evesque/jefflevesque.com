# URLs the weekly link check must not follow (.github/workflows/links.yml).
# One regular expression per line.

# The local preview server, from `mkdocs serve`.
^http://127\.0\.0\.1
^http://localhost

# The three public API endpoints. Called without parameters, performance and the
# datalake answer an error, which a link checker reports as broken. The API pages'
# Try it out is what exercises them.
^https://api\.jefflevesque\.com/v1/public/

# Ontology terms, in the knowledge graph examples. They are identifiers, not
# addresses: nothing is served at those paths, and a 404 there is the expected
# answer rather than a broken link.
^https://jefflevesque\.com/ontology/
