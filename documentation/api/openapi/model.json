          "400": {
            "description": "Model without Report, or the other way round; a Report that is not one of the three; any other parameter, even a lowercase model; or either one given twice.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "report"
                  ],
                  "properties": {
                    "report": {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "together": {
                    "summary": "Model without Report, or a Report that is not one of the three",
                    "value": {
                      "report": {
                        "error": "Model and Report go together, and Report is summary, history or track-record."
                      }
                    }
                  },
                  "other": {
                    "summary": "Any other parameter, even a lowercase model",
                    "value": {
                      "report": {
                        "error": "Model and Report are the only parameters."
                      }
                    }
                  },
                  "twice": {
                    "summary": "Model or Report given twice",
                    "value": {
                      "report": {
                        "error": "Model and Report may each be given once."
                      }
                    }
                  }
                }
              }
            }
          },
