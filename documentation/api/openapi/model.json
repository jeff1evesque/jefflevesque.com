{
  "openapi": "3.1.0",
  "info": {
    "title": "Model",
    "version": "v1",
    "description": "The models trained every night, and how each one scores: every nightly attempt to better it, and every day it predicted. Read by /model and /model/<name>. Scores only: nothing here says how a model is built."
  },
  "servers": [
    {
      "url": "https://api.jefflevesque.com/v1/public"
    }
  ],
  "paths": {
    "/model": {
      "get": {
        "operationId": "getModel",
        "summary": "The models, or one model's summary, history or track record",
        "description": "Four calls on one path. With no parameters, the listing, as JSON. With a Model from the listing and a Report, one of that model's reports: summary, its summary, as JSON; or history, one row per nightly attempt, or track-record, one row per day it predicted, each as a CSV string with a header row. Model and Report go together: either alone is a 400.",
        "parameters": [
          {
            "name": "Model",
            "in": "query",
            "required": false,
            "description": "A model's name, from the listing. Asked with Report.",
            "schema": {
              "type": "string"
            },
            "example": "pt-gnn-5day"
          },
          {
            "name": "Report",
            "in": "query",
            "required": false,
            "description": "Which of the model's reports: summary, its summary, as JSON; history, one row per nightly attempt; or track-record, one row per day it predicted. Asked with Model.",
            "schema": {
              "type": "string",
              "enum": [
                "summary",
                "history",
                "track-record"
              ]
            },
            "example": "track-record"
          }
        ],
        "responses": {
          "200": {
            "description": "With no parameters, the listing. With Model and Report=summary, the model's summary, as an object. With Model and Report=history or track-record, a CSV string with a header row, oldest row first. Each score column is a number, or empty where a day has no such score.\n\nhistory, one row per nightly attempt: day, the night it was trained; kind, nightly for a nightly update or weekly for a weekly retrain; went_live, true when it replaced the live version; started, when the attempt began, in UTC with its offset, e.g. 2026-10-16T07:58:10+00:00; training_seconds, the time spent training, reading the days included, to one decimal; total_seconds, from started until the attempt's scores are known, so its training and then scoring the held-out days for the attempt and for the live version, to one decimal; and each score of the attempt, of the live version and of the know-nothing baseline, all on the same held-out days: attempt_<score>, live_<score> and baseline_<score>. started, training_seconds and total_seconds are empty for attempts made before 2026-10-15.\n\ntrack-record, one row per day the model predicted, written once that day is scored: day, the day the prediction was made; each score, as <score>; and the baseline's, as baseline_<score>. A day the model was not running has no row.\n\nThe scores are loss, auc_up, auc_beats and acc_up. Loss is lower-is-better, and an attempt goes live only when its loss is no higher than the live version's.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "report"
                  ],
                  "properties": {
                    "report": {
                      "anyOf": [
                        {
                          "type": "object",
                          "description": "Asked with no parameters: every task, and every model with its latest scores.",
                          "required": [
                            "tasks",
                            "models"
                          ],
                          "properties": {
                            "tasks": {
                              "type": "array",
                              "description": "What the models predict, in the order /model lists them.",
                              "items": {
                                "type": "object",
                                "required": [
                                  "id",
                                  "name",
                                  "description"
                                ],
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "description": "What a model names its task by."
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "description": {
                                    "type": "string",
                                    "description": "One line: what is predicted, and when it is scored."
                                  }
                                }
                              }
                            },
                            "models": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "name",
                                  "task",
                                  "description",
                                  "started",
                                  "retired",
                                  "scored_days",
                                  "live",
                                  "attempts",
                                  "score",
                                  "baseline"
                                ],
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "description": "The name Model takes, and the last part of the model's address on the site, /model/<name>."
                                  },
                                  "task": {
                                    "type": "string",
                                    "description": "The id of the task it predicts."
                                  },
                                  "description": {
                                    "type": "string",
                                    "description": "One line about the model."
                                  },
                                  "started": {
                                    "type": "string",
                                    "description": "The first day it predicted, as YYYY-MM-DD."
                                  },
                                  "retired": {
                                    "type": [
                                      "string",
                                      "null"
                                    ],
                                    "description": "The day it stopped being trained, as YYYY-MM-DD, or null while it still is."
                                  },
                                  "scored_days": {
                                    "type": "integer",
                                    "description": "The rows of its track record: the days it predicted that have been scored."
                                  },
                                  "live": {
                                    "type": "object",
                                    "description": "The version making its predictions, or the last one that did, for a retired model.",
                                    "required": [
                                      "since",
                                      "kind"
                                    ],
                                    "properties": {
                                      "since": {
                                        "type": "string",
                                        "description": "The night it went live, as YYYY-MM-DD."
                                      },
                                      "kind": {
                                        "type": "string",
                                        "enum": [
                                          "first",
                                          "nightly",
                                          "weekly"
                                        ],
                                        "description": "first, while the model's first version is still live; otherwise whether a nightly update or a weekly retrain made it."
                                      }
                                    }
                                  },
                                  "attempts": {
                                    "type": "object",
                                    "description": "The rows of its history.",
                                    "required": [
                                      "total",
                                      "went_live"
                                    ],
                                    "properties": {
                                      "total": {
                                        "type": "integer",
                                        "description": "Every nightly attempt."
                                      },
                                      "went_live": {
                                        "type": "integer",
                                        "description": "The attempts that replaced the live version."
                                      }
                                    }
                                  },
                                  "score": {
                                    "type": [
                                      "object",
                                      "null"
                                    ],
                                    "description": "Each score averaged over the last 20 rows of its track record, or all of them while it has fewer. Null while it has none.",
                                    "required": [
                                      "loss",
                                      "auc_up",
                                      "auc_beats",
                                      "acc_up"
                                    ],
                                    "properties": {
                                      "loss": {
                                        "type": [
                                          "number",
                                          "null"
                                        ],
                                        "description": "Lower is better."
                                      },
                                      "auc_up": {
                                        "type": [
                                          "number",
                                          "null"
                                        ]
                                      },
                                      "auc_beats": {
                                        "type": [
                                          "number",
                                          "null"
                                        ]
                                      },
                                      "acc_up": {
                                        "type": [
                                          "number",
                                          "null"
                                        ],
                                        "description": "A share, 0 to 1."
                                      }
                                    }
                                  },
                                  "baseline": {
                                    "type": [
                                      "object",
                                      "null"
                                    ],
                                    "description": "The know-nothing baseline's scores, averaged over the same days. Null while it has none.",
                                    "required": [
                                      "loss",
                                      "auc_up",
                                      "auc_beats",
                                      "acc_up"
                                    ],
                                    "properties": {
                                      "loss": {
                                        "type": [
                                          "number",
                                          "null"
                                        ],
                                        "description": "Lower is better."
                                      },
                                      "auc_up": {
                                        "type": [
                                          "number",
                                          "null"
                                        ]
                                      },
                                      "auc_beats": {
                                        "type": [
                                          "number",
                                          "null"
                                        ]
                                      },
                                      "acc_up": {
                                        "type": [
                                          "number",
                                          "null"
                                        ],
                                        "description": "A share, 0 to 1."
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        {
                          "type": "object",
                          "description": "Asked with Model and Report=summary: one model's summary. No page reads it yet, so its fields are not listed here."
                        },
                        {
                          "type": "string",
                          "description": "Asked with Model and Report=history or track-record: the report, as a CSV string with a header row."
                        }
                      ]
                    }
                  }
                },
