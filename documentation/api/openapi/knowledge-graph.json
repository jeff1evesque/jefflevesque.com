                    "report": {
                      "type": "object",
                      "required": [
                        "rows"
                      ],
                      "properties": {
                        "rows": {
                          "type": "array",
                          "description": "One object per row. The columns depend on the Operation.",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        }
                      }
                    }
                  }
                },
