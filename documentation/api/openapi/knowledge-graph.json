          {
            "name": "Text",
            "in": "query",
            "required": true,
            "description": "Required by Find. Matched as a case-insensitive substring of an entity's text. Wildcards are refused, so a literal % or _ cannot widen the match.",
            "schema": {
              "type": "string"
            },
            "example": "apple"
          },
          {
            "name": "Limit",
            "in": "query",
            "required": false,
            "description": "The most rows to answer with. The service applies a ceiling of its own, so a larger value does not widen the answer.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 10
