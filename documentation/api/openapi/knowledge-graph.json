    "/knowledge-graph/tables/facts": {
      "get": {
        "operationId": "listKnowledgeGraphFacts",
        "summary": "The values held about one entity",
        "description": "Everything the build holds about one entity. Reads across the published window unless a Day narrows it.",
        "parameters": [
          {
            "name": "Uri",
            "in": "query",
            "required": true,
            "description": "Required by Facts and Neighborhood. The entity to read, as its uri from a Find result. Uris are stable across days, unlike the numeric ids the tables join on.",
            "schema": {
              "type": "string"
            },
            "example": "https://jefflevesque.com/ontology/unified/Company_0000001800"
          },
          {
            "name": "Day",
            "in": "query",
            "required": false,
            "description": "A published day, as YYYY-MM-DD. Required by Neighborhood, because ids are renumbered daily and an edge only means anything joined within its own day. Optional for Facts, which reads across the published window when it is omitted.",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "example": "2026-09-18"
          },
          {
            "name": "Limit",
            "in": "query",
            "required": false,
            "description": "The most rows to answer with. The service applies a ceiling of its own, so a larger value does not widen the answer.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "The rows the question answers with, which may legitimately be empty.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "report"
                  ],
                  "properties": {
                    "report": {
                      "type": "object",
                      "required": [
                        "rows"
                      ],
                      "properties": {
                        "rows": {
                          "type": "array",
                          "description": "One object per row. The columns depend on the Operation.",
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "report": {
                    "rows": [
                      {
                        "src_type": "filings_SECFiling",
                        "relation": "filings_hasIssuer",
                        "dst_type": "sec_enrichment_UnifiedCompany",
                        "count": 838
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "An operation the service does not offer, or a value meaningless to the one named. The rejected value is never echoed back.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "report"
                  ],
                  "properties": {
                    "report": {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "report": {
                    "error": "Operation NOT recognized, expected one of EdgeTypes, Find, Neighborhood, Facts"
                  }
                }
              }
            }
          },
          "404": {
            "description": "A named Day that is not a published day, or no published day at all.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "report"
                  ],
                  "properties": {
                    "report": {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "report": {
                    "error": "not a published day"
                  }
                }
              }
            }
